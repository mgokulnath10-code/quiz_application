# BrainRace backend environment template.
#
# Copy to backend/.env and fill in real values locally.
# NEVER commit real secrets. The deployed backend must have
# these set in the host's dashboard (e.g. Render > Environment).

# --- Server --------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database / auth ----------------------------------------
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/brainrace
JWT_SECRET=replace-with-a-long-random-string

# Admin portal credentials. If these are unset the server
# refuses admin login with code ADMIN_NOT_CONFIGURED.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Outbound email (OTP delivery) --------------------------
# When these are set, OTP codes are emailed and never exposed
# through the API. For Gmail use an App Password, not the
# account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=BrainRace <no-reply@example.com>

# --- Dev-only OTP exposure ----------------------------------
# Only honoured when NODE_ENV is NOT production. When true and
# SMTP is missing, API responses include devCode so the flow can
# be tested locally. Leave false/absent everywhere else.
ALLOW_DEV_OTP=false

# --- OAuth (Google) -----------------------------------------
# Google Cloud Console > APIs & Services > Credentials.
# Register this EXACT authorised redirect URI:
#   https://<SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-full-google-client-secret

# --- OAuth (Microsoft) --------------------------------------
# Azure Portal > App registrations. Redirect URI:
#   https://<SERVER_URL>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Public URLs --------------------------------------------
# SERVER_URL must be the public backend origin (no trailing
# slash) so the OAuth redirect_uri matches the console.
SERVER_URL=https://your-backend.example.com
# FRONTEND_URL is where OAuth and password flows return to.
FRONTEND_URL=https://your-frontend.example.com
